{
  "name": "faxuanyun-legal-exam-assistant",
  "version": "2.0.21",
  "private": true,
  "description": "甘肃省国家工作人员学法考试平台（法宣在线）Tampermonkey 用户脚本：本地题库 + AI/百度多源 + 自动答题与成绩对账",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/selftest.mjs && node tests/merge-smoke.mjs",
    "check": "node tools/check-syntax.mjs && node tools/check-docs.mjs && node tests/selftest.mjs && node tools/check-data.mjs && node tools/check-workflows.mjs && node tests/merge-smoke.mjs",
    "merge-smoke": "node tests/merge-smoke.mjs",
    "ci": "node tools/ci.mjs",
    "smoke": "node tests/panel-smoke.mjs --require-browser && node tests/page-smoke.mjs --require-browser",
    "docs:images": "node tools/generate-docs-images.mjs",
    "release": "node tools/release.mjs"
  },
  "author": "Gnayiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gnayiel/faxuanyun-legal-exam-assistant.git"
  },
  "homepage": "https://github.com/Gnayiel/faxuanyun-legal-exam-assistant#readme",
  "bugs": {
    "url": "https://github.com/Gnayiel/faxuanyun-legal-exam-assistant/issues"
  },
  "keywords": [
    "tampermonkey",
    "userscript",
    "faxuanyun",
    "legal-exam",
    "automation",
    "javascript"
  ]
}
